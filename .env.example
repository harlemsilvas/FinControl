NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=fincontrol
DB_USER=fincontrol
DB_PASSWORD=change_me
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Gere um segredo aleatorio com pelo menos 32 caracteres para cada ambiente.
AUTH_ACCESS_TOKEN_SECRET=change_me_to_a_random_secret_with_32_chars
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_ISSUER=fincontrol-api
AUTH_AUDIENCE=fincontrol
AUTH_PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_BASE_URL=http://localhost:5173/password-reset

# Envio real de e-mail. Quando SMTP_ENABLED=false, a recuperacao fica registrada
# como PENDING em administracao.email_outbox.
SMTP_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hrmmotos
SMTP_PASSWORD=senha_do_email
SMTP_FROM_EMAIL=hrmmotos@hrmmotos.com.br
SMTP_FROM_NAME=FinControl

# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=hrmmotos@hrmmotos.com.br
# MAIL_PASSWORD=sua_senha_do_email
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS=hrmmotos@hrmmotos.com.br
# MAIL_FROM_NAME="${APP_NAME}"

ATTACHMENT_STORAGE_ROOT=/opt/fincontrol/storage
ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760

# Rotina administrativa de backup do banco. Na VPS, use sudoers restrito para
# permitir que o usuario da API execute somente o script versionado.
BACKUP_DIRECTORY=/opt/fincontrol/shared/backups
BACKUP_SCRIPT_PATH=/opt/fincontrol/bin/backup-db
BACKUP_SCRIPT_USE_SUDO=true

# Somente para o comando explicito `npm run bootstrap:master --workspace @fincontrol/api`.
BOOTSTRAP_MASTER_NAME=Operador Master
BOOTSTRAP_MASTER_EMAIL=master@example.com
BOOTSTRAP_MASTER_PASSWORD=123456
